# Copy this file to .env and fill in your own values. Never commit .env.
#
# Both variables are your own n8n webhook URLs (agent chat and lead capture).
# See README.md for what each workflow expects to receive and return.

VITE_AGENT_CHAT_URL=
VITE_LEAD_CAPTURE_URL=

# Optional. Set to "true" to switch off all network calls (agent and form
# both become visibly disabled). Used for the public demo/portfolio build.
VITE_DEMO_MODE=false
