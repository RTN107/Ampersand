    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst warehouseScores = {\n  \"1\": 1,\n  \"2-5\": 3,\n  \"6-10\": 5,\n  \"10+\": 6\n};\n\nconst volumeScores = {\n  \"Under 500\": 1,\n  \"500 to 5000\": 3,\n  \"5000 to 20000\": 5,\n  \"20000+\": 6\n};\n\nconst toolingScores = {\n  \"Spreadsheets or manual\": 4,\n  \"Nothing\": 2,\n  \"Another platform\": 1\n};\n\nconst timelineScores = {\n  \"This month\": 4,\n  \"This quarter\": 2,\n  \"Just exploring\": 0\n};\n\nconst score =\n  (warehouseScores[body.warehouse_count] || 0) +\n  (volumeScores[body.order_volume] || 0) +\n  (toolingScores[body.current_tooling] || 0) +\n  (timelineScores[body.timeline] || 0);\n\nconst intent = score >= 12 ? \"high\" : \"low\";\n\nreturn {\n  json: {\n    ...body,\n    score,\n    intent\n  }\n};"
      },
